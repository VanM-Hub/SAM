# Normalize line endings for all text files
* text=auto

# Explicitly set LF for Markdown files
*.md text eol=lf

# Explicitly set LF for YAML, JSON, and other config files
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh text eol=lf

# Keep Windows batch files as CRLF
*.bat text eol=crlf
*.cmd text eol=crlf