/uv.lock

# Temp files
*.log
*.log.*
*.tmp
*.temp
temp_screenshot.png

# Runtime demo/sandbox dir (dibuat otomatis oleh real harness saat jalan) - jangan commit
_demo/
docs/_demo/

# Coverage
.coverage
htmlcov/
test-results.xml

# Local runtime data (root-level only; NOT src/sam/.../workspace subpackages)
/workspace/
approvals.json
openclaw/status/
/memory/

# Database — jangan commit!
*.db
*.db-*
*.sqlite
*.sqlite3

# Runtime state (M10-007 persistence) — output proses, jangan commit
/docs/engineering/state/
*.sam_ux_*.tmp

# Migrations dir tetap di-track
!data/migrations/
!data/migrations/*.sql

# Runtime checkpoints/recovery state - jangan commit
/data/checkpoints/
/data/checkpoints/**
!/data/checkpoints/.gitkeep

# ZaraNote - catatan internal, bukan bagian project
ZaraNote/
ZN_*/

# docs/engineering/ subfolders - workspace yang terus berubah selama SAM ada,
# isi (file SAM 3.x) tidak dilacak git. ACTUAL_STATE.md & decisions/ARCHITECTURE ORDER.md tetap di-track.
# .gitkeep dikecualikan agar folder tetap eksis di repo (isi dikosongkan, folder tidak dihapus).
docs/engineering/roadmap/*
docs/engineering/strategy/*
docs/engineering/journals/*
docs/engineering/reports/*
docs/engineering/references/*
docs/engineering/templates/*
!docs/engineering/**/.gitkeep

# Laporan audit nyata (P0-P11) + Truth Matrix WAJIB ter-track (override ignore SAM lama)
!docs/engineering/reports/CAPABILITY_TRUTH_MATRIX.md
!docs/engineering/reports/Daftar_Capability_Potensi_Fungsi_SAM.md
!docs/engineering/reports/P2A_*.md
